@page "/recuperar-password"
@using Inventario.Web.Models
@using Inventario.Web.Services
@inject AuthService Auth

<PageTitle>Recuperar contraseña</PageTitle>
<h1>Recuperar contraseña</h1>

<EditForm Model="modelo" OnValidSubmit="Solicitar">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Correo electrónico</label>
        <InputText class="form-control" @bind-Value="modelo.Email" />
        <ValidationMessage For="() => modelo.Email" />
    </div>

    <button class="btn btn-primary" type="submit">Enviar código</button>
</EditForm>

@if (mensaje is not null)
{
    <div class="alert alert-info mt-3">
        <p>@mensaje</p>
        <a class="alert-link" href="/restablecer-password?email=@Uri.EscapeDataString(modelo.Email)">
            Tengo el código, definir nueva contraseña
        </a>
    </div>
}

<p class="mt-3"><a href="/login">Volver al inicio de sesión</a></p>

@code {
    private SolicitarRecuperacionRequest modelo = new();
    private string? mensaje;

    private async Task Solicitar()
    {
        // RF-CA-09: siempre se muestra el mismo mensaje, exista o no el correo.
        mensaje = await Auth.SolicitarRecuperacionAsync(modelo.Email);
    }
}
