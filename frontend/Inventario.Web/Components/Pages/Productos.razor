@page "/productos"
@attribute [Authorize]
@using Inventario.Web.Models
@using Inventario.Web.Services
@inject CatalogoServices Catalogo

<PageTitle>Productos</PageTitle>
<h1>Productos</h1>

@if (mensaje is not null)
{
    <div class="alert alert-success">@mensaje</div>
}
@if (error is not null)
{
    <div class="alert alert-danger">@error</div>
}

<div class="row">
    <div class="col-md-7">
        <h2 class="h5">Listado</h2>

        @if (cargando)
        {
            <p>Cargando productos...</p>
        }
        else if (productos.Count == 0)
        {
            <p>No hay productos registrados.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Nombre</th>
                            <th>Código</th>
                            <th>Precio</th>
                            <th>Stock</th>
                            <th>Proveedor</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var producto in productos)
                        {
                            <tr>
                                <td>@producto.Id</td>
                                <td>@producto.Nombre</td>
                                <td>@producto.Codigo</td>
                                <td>@producto.Precio.ToString("0.00")</td>
                                <td>@producto.StockActual (mín. @producto.StockMinimo)</td>
                                <td>@producto.ProveedorNombre</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <div class="col-md-5">
        <AuthorizeView Roles="Administrador">
            <Authorized>
                <div class="card">
                    <div class="card-body">
                        <h2 class="h5 card-title">Nuevo producto</h2>

                        @if (proveedores.Count == 0)
                        {
                            <div class="alert alert-warning">
                                Primero crea un proveedor en <a href="proveedores">/proveedores</a>.
                            </div>
                        }

                        <div class="mb-3">
                            <label class="form-label">Nombre</label>
                            <input class="form-control" @bind="nombre" maxlength="100" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Código (opcional)</label>
                            <input class="form-control" @bind="codigo" />
                            <div class="form-text">Si lo dejas vacío se genera uno automáticamente.</div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Proveedor</label>
                            <select class="form-select" @bind="proveedorId">
                                <option value="0">— Selecciona un proveedor —</option>
                                @foreach (var proveedor in proveedores)
                                {
                                    <option value="@proveedor.Id">@proveedor.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Precio</label>
                            <input class="form-control" type="number" min="0" step="0.01" @bind="precio" />
                        </div>
                        <div class="row">
                            <div class="col">
                                <label class="form-label">Stock actual</label>
                                <input class="form-control" type="number" min="0" @bind="stockActual" />
                            </div>
                            <div class="col">
                                <label class="form-label">Stock mínimo</label>
                                <input class="form-control" type="number" min="0" @bind="stockMinimo" />
                            </div>
                        </div>

                        <button class="btn btn-primary w-100 mt-3" disabled="@enviando" @onclick="CrearAsync">
                            @(enviando ? "Creando..." : "Crear producto")
                        </button>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="alert alert-info">
                    Solo un Administrador puede crear productos.
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </div>
</div>

@code {
    private List<ProductoDto> productos = new();
    private List<ProveedorDto> proveedores = new();
    private bool cargando = true;
    private bool enviando;
    private string? mensaje;
    private string? error;

    private string nombre = string.Empty;
    private string? codigo;
    private int proveedorId;
    private decimal precio;
    private int stockActual;
    private int stockMinimo;

    protected override async Task OnInitializedAsync()
    {
        var resultadoProveedores = await Catalogo.ListarProveedoresAsync();
        if (resultadoProveedores.Ok)
        {
            proveedores = resultadoProveedores.Proveedores;
        }
        else
        {
            error = resultadoProveedores.Mensaje;
        }

        await CargarAsync();
    }

    private async Task CargarAsync()
    {
        cargando = true;
        var resultado = await Catalogo.ListarProductosAsync();
        if (resultado.Ok)
        {
            productos = resultado.Productos;
        }
        else
        {
            error = resultado.Mensaje;
        }
        cargando = false;
    }

    private async Task CrearAsync()
    {
        mensaje = null;
        error = null;

        if (string.IsNullOrWhiteSpace(nombre))
        {
            error = "El nombre del producto es obligatorio.";
            return;
        }
        if (proveedorId <= 0)
        {
            error = "Selecciona un proveedor.";
            return;
        }
        if (precio < 0 || stockActual < 0 || stockMinimo < 0)
        {
            error = "El precio y el stock no pueden ser negativos.";
            return;
        }

        enviando = true;
        var resultado = await Catalogo.CrearProductoAsync(new CrearProductoRequest
        {
            Nombre = nombre,
            Codigo = string.IsNullOrWhiteSpace(codigo) ? null : codigo,
            Precio = precio,
            StockActual = stockActual,
            StockMinimo = stockMinimo,
            ProveedorId = proveedorId
        });
        enviando = false;

        if (!resultado.Ok)
        {
            error = resultado.Mensaje;
            return;
        }

        mensaje = $"Producto \"{resultado.Producto?.Nombre}\" creado con código {resultado.Producto?.Codigo}.";
        nombre = string.Empty;
        codigo = null;
        proveedorId = 0;
        precio = 0;
        stockActual = 0;
        stockMinimo = 0;
        await CargarAsync();
    }
}
