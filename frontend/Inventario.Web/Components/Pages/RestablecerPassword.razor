@page "/restablecer-password"
@using Inventario.Web.Models
@using Inventario.Web.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Restablecer contraseña</PageTitle>
<h1>Restablecer contraseña</h1>

<EditForm Model="modelo" OnValidSubmit="Restablecer">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Correo electrónico</label>
        <InputText class="form-control" @bind-Value="modelo.Email" />
        <ValidationMessage For="() => modelo.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Código de recuperación</label>
        <InputText class="form-control" maxlength="6" inputmode="numeric"
                   @bind-Value="modelo.Codigo" />
        <ValidationMessage For="() => modelo.Codigo" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nueva contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="modelo.NuevaPassword" />
        <ValidationMessage For="() => modelo.NuevaPassword" />
    </div>

    <div class="mb-3">
        <label class="form-label">Confirmar nueva contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="modelo.ConfirmarPassword" />
        <ValidationMessage For="() => modelo.ConfirmarPassword" />
    </div>

    <button class="btn btn-primary" type="submit">Restablecer contraseña</button>
</EditForm>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

<p class="mt-3"><a href="/login">Volver al inicio de sesión</a></p>

@code {
    private RestablecerPasswordRequest modelo = new();
    private string? error;

    [SupplyParameterFromQuery(Name = "email")]
    public string? Email { get; set; }

    protected override void OnInitialized()
    {
        // Comodidad: el enlace de /recuperar-password ya trae el correo.
        if (!string.IsNullOrWhiteSpace(Email)) modelo.Email = Email;
    }

    private async Task Restablecer()
    {
        error = null;

        // RF-CA-10/11: el backend rechaza códigos usados o vencidos y guarda el hash.
        var (ok, mensaje) = await Auth.RestablecerPasswordAsync(modelo);
        if (!ok)
        {
            error = mensaje;
            return;
        }

        // RF-CA-12: las sesiones anteriores ya no sirven.
        Nav.NavigateTo("/login?clave=restablecida");
    }
}
