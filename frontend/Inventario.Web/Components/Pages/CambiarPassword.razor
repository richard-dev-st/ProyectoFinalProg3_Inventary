@page "/cambiar-password"
@attribute [Authorize]
@using Inventario.Web.Models
@using Inventario.Web.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Cambiar contraseña</PageTitle>
<h1>Cambiar contraseña</h1>

<EditForm Model="modelo" OnValidSubmit="Cambiar">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Contraseña actual</label>
        <InputText class="form-control" type="password" @bind-Value="modelo.PasswordActual" />
        <ValidationMessage For="() => modelo.PasswordActual" />
    </div>

    <div class="mb-3">
        <label class="form-label">Nueva contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="modelo.NuevaPassword" />
        <ValidationMessage For="() => modelo.NuevaPassword" />
    </div>

    <div class="mb-3">
        <label class="form-label">Confirmar nueva contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="modelo.ConfirmarPassword" />
        <ValidationMessage For="() => modelo.ConfirmarPassword" />
    </div>

    <button class="btn btn-primary" type="submit">Cambiar contraseña</button>
</EditForm>

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

<p class="mt-3"><a href="/">Volver al inicio</a></p>

@code {
    private CambiarPasswordRequest modelo = new();
    private string? error;

    protected override async Task OnInitializedAsync()
    {
        // RF-CA-20/RF-CA-12: una sesión revocada o anterior al cambio no debe usar este formulario.
        if (await Auth.ObtenerUsuarioActualAsync() is null) Nav.NavigateTo("/login");
    }

    private async Task Cambiar()
    {
        error = null;

        // RF-CA-22: la API verifica la contraseña actual y responde 404 con { mensaje } si falla.
        var (ok, mensaje) = await Auth.CambiarPasswordAsync(modelo);
        if (!ok)
        {
            error = mensaje;
            return;
        }

        // RF-CA-12: AuthService ya cerró la sesión local porque el token quedó invalidado.
        Nav.NavigateTo("/login?clave=actualizada");
    }
}
