@page "/registrar"
@using Inventario.Web.Models
@using Inventario.Web.Services
@inject AuthService Auth
@inject NavigationManager Nav

<PageTitle>Crear cuenta</PageTitle>
<h1>Crear cuenta</h1>

<EditForm Model="modelo" OnValidSubmit="RegistrarCuenta">
    <DataAnnotationsValidator />

    <div class="mb-3">
        <label class="form-label">Correo electrónico</label>
        <InputText class="form-control" @bind-Value="modelo.Email" />
        <ValidationMessage For="() => modelo.Email" />
    </div>

    <div class="mb-3">
        <label class="form-label">Contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="modelo.Password" />
        <ValidationMessage For="() => modelo.Password" />
    </div>

    <div class="mb-3">
        <label class="form-label">Confirmar contraseña</label>
        <InputText class="form-control" type="password" @bind-Value="modelo.ConfirmarPassword" />
        <ValidationMessage For="() => modelo.ConfirmarPassword" />
    </div>

    <button class="btn btn-primary" type="submit">Registrarme</button>
</EditForm>

@if (mensaje is not null)
{
    <div class="alert alert-success mt-3">
        <p>@mensaje</p>
        <a href="/login" class="alert-link">Ir a iniciar sesión</a>
    </div>
}

@if (error is not null)
{
    <div class="alert alert-danger mt-3">@error</div>
}

<p class="mt-3"><a href="/login">Ya tengo cuenta</a></p>

@code {
    private RegistroRequest modelo = new();
    private string? mensaje;
    private string? error;

    private async Task RegistrarCuenta()
    {
        mensaje = null;
        error = null;

        // RF-CA-15: el campo es obligatorio en la API, que después usa su URL configurada.
        var (ok, resultado) = await Auth.RegistrarAsync(modelo, Nav.BaseUri);
        if (ok)
        {
            mensaje = resultado;
            return;
        }

        error = resultado;
    }
}
