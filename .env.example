# Base de datos
# SQL Server exige 8+ caracteres con mayúscula, minúscula, dígito y símbolo.
# Evita $ ; " ' y # dentro del valor: rompen la interpolación de Compose.
MSSQL_SA_PASSWORD=Inventario2026!

# JWT (mínimo 32 caracteres recomendado)
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria-de-32-o-mas

# SMTP (valores de ejemplo; los correos no se enviarán con ellos)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASSWORD=valor-de-ejemplo
SMTP_USE_SSL=true